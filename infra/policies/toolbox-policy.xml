<policies>
  <inbound>
    <base />
    <validate-azure-ad-token
      tenant-id="__TENANT_ID__"
      header-name="Authorization"
      failed-validation-httpcode="401"
      failed-validation-error-message="A valid MCP user token is required.">
      <audiences>
        <audience>__MCP_APP_ID__</audience>
        <audience>__MCP_RESOURCE__</audience>
      </audiences>
      <required-claims>
        <claim name="scp" match="any" separator=" ">
          <value>user_impersonate</value>
        </claim>
      </required-claims>
    </validate-azure-ad-token>
    <choose>
      <when condition="@(context.Request.Method.Equals(&quot;GET&quot;, StringComparison.OrdinalIgnoreCase))">
        <return-response>
          <set-status code="405" reason="Method Not Allowed" />
        </return-response>
      </when>
    </choose>
    <authentication-managed-identity
      resource="api://AzureADTokenExchange"
      output-token-variable-name="client-assertion"
      ignore-error="false" />
    <send-request mode="new" response-variable-name="obo-response" timeout="20" ignore-error="false">
      <set-url>https://login.microsoftonline.com/__TENANT_ID__/oauth2/v2.0/token</set-url>
      <set-method>POST</set-method>
      <set-header name="Content-Type" exists-action="override">
        <value>application/x-www-form-urlencoded</value>
      </set-header>
      <set-body>@{
        var incomingToken = context.Request.Headers
          .GetValueOrDefault("Authorization", "")
          .Substring("******".Length);
        return "client_id=" + System.Net.WebUtility.UrlEncode("__MCP_APP_ID__")
          + "&amp;grant_type=" + System.Net.WebUtility.UrlEncode("urn:ietf:params:oauth:grant-type:jwt-bearer")
          + "&amp;requested_token_use=on_behalf_of"
          + "&amp;scope=" + System.Net.WebUtility.UrlEncode("https://ai.azure.com/.default")
          + "&amp;assertion=" + System.Net.WebUtility.UrlEncode(incomingToken)
          + "&amp;client_assertion_type=" + System.Net.WebUtility.UrlEncode("urn:ietf:params:oauth:client-assertion-type:jwt-bearer")
          + "&amp;client_assertion=" + System.Net.WebUtility.UrlEncode((string)context.Variables["client-assertion"]);
      }</set-body>
    </send-request>
    <choose>
      <when condition="@(((IResponse)context.Variables[&quot;obo-response&quot;]).StatusCode != 200)">
        <return-response>
          <set-status code="502" reason="Foundry token exchange failed" />
        </return-response>
      </when>
    </choose>
    <set-header name="Authorization" exists-action="override">
      <value>@("Bearer " + ((IResponse)context.Variables["obo-response"]).Body.As&lt;Newtonsoft.Json.Linq.JObject&gt;()["access_token"].ToString())</value>
    </set-header>
    <send-request mode="copy" response-variable-name="toolbox-response" timeout="120" ignore-error="false">
      <set-url>__TOOLBOX_MCP_URL__</set-url>
    </send-request>
    <return-response response-variable-name="toolbox-response" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
