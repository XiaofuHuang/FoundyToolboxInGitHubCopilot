{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Foundry Toolbox Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}\\dist\\extension.js"
      ],
      "preLaunchTask": "npm: build:debug"
    }
  ]
}
