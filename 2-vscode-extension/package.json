{
  "name": "foundry-toolbox-auth",
  "displayName": "Foundry Toolbox Authentication",
  "description": "Returns a Foundry token to VS Code MCP configuration and preflights Toolbox GitHub consent.",
  "version": "0.0.5",
  "publisher": "xiaofhua-local",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/XiaofuHuang/FoundyToolboxInGitHubCopilot.git",
    "directory": "2-vscode-extension"
  },
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:foundryToolboxAuth.getAccessToken",
    "onCommand:foundryToolboxAuth.signIn"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "README.md",
    "README.zh-CN.md",
    "samples/vscode/mcp.json.example",
    "settings.json.example"
  ],
  "extensionDependencies": [
    "ms-azuretools.vscode-azureresourcegroups"
  ],
  "contributes": {
    "commands": [
      {
        "command": "foundryToolboxAuth.signIn",
        "title": "Foundry Toolbox: Sign In"
      },
      {
        "command": "foundryToolboxAuth.getAccessToken",
        "title": "Foundry Toolbox: Get Access Token",
        "enablement": "false"
      }
    ],
    "configuration": {
      "title": "Foundry Toolbox Authentication",
      "properties": {
        "foundryToolboxAuth.tenantId": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Microsoft Entra tenant ID that owns the Foundry project."
        },
        "foundryToolboxAuth.toolboxUrl": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Direct Microsoft Foundry Toolbox MCP endpoint, including ?api-version=v1."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc -p .",
    "build": "npm run check && esbuild extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "package": "npm run build && npx @vscode/vsce package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@microsoft/vscode-azext-azureauth": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.134.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
